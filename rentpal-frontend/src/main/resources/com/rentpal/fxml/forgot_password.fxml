<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import java.net.URL?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.rentpal.controllers.auth.ForgotPasswordController"
           prefWidth="1200" prefHeight="800">

    <stylesheets>
        <URL value="@/css/login.css" />
    </stylesheets>

    <AnchorPane>
        <!-- Background gradient matching login page -->
        <StackPane style="-fx-background-color: linear-gradient(to bottom right, #e3f2fd 0%, #d0e7ff 50%, #b3d5ff 100%);"
                   AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0"
                   AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0"/>

        <VBox fx:id="forgotPasswordBox" alignment="CENTER" spacing="20"
              AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0"
              AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">

            <padding>
                <Insets top="40" right="40" bottom="40" left="40"/>
            </padding>

            <Label text="Forgot Password" styleClass="label-title"/>

            <Label text="Enter your registered email to reset password"
                   style="-fx-font-size: 16px; -fx-text-fill: #546e7a; -fx-padding: 0 0 20 0;"/>

            <TextField fx:id="emailField" promptText="Email address" styleClass="input-field"/>

            <Button text="Send Reset Link" onAction="#handleReset"
                    styleClass="action-btn" prefWidth="320" prefHeight="48"/>

            <HBox alignment="CENTER" spacing="20" style="-fx-padding: 10 0 0 0;">
                <Button text="Back to Login" onAction="#handleBack"
                        styleClass="cancel-btn" prefWidth="150" prefHeight="40"/>

                <Button text="Back to Home" onAction="#handleBackToHome"
                        styleClass="cancel-btn" prefWidth="150" prefHeight="40"/>
            </HBox>
        </VBox>
    </AnchorPane>
</StackPane>