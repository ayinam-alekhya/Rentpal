<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="700" prefWidth="980" styleClass="content-inner" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.rentpal.controllers.tenantdashboard.TenantComplaintsController">

    <!-- HEADER SECTION -->
    <top>
        <HBox spacing="15" styleClass="page-header">
            <Pane HBox.hgrow="ALWAYS">
                <children>
                    <Label alignment="CENTER" layoutX="441.0" layoutY="2.0" styleClass="page-title" text="My Complaints" />
                </children>
            </Pane>
        </HBox>
    </top>

    <!-- TABLE SECTION -->
    <center>
        <VBox spacing="20" styleClass="main-content">
            <HBox spacing="15" styleClass="filter-bar">
                <TextField fx:id="searchComplaints" promptText="Search by title or description..." styleClass="search-field" />
                <ComboBox fx:id="filterComboBox" prefWidth="160" promptText="Filter by status" />
                <Pane HBox.hgrow="ALWAYS">
                    <children>
                        <!-- ✅ Button now calls the controller method -->
                        <Button fx:id="addComplaint" layoutX="517.0" onAction="#handleAddComplaint" styleClass="add-btn" text="+ Add Complaint" />
                    </children>
                </Pane>
            </HBox>
            <!-- Complaints Table -->
            <TableView fx:id="complaintsTable" prefHeight="500" styleClass="table-view">
                <columns>
                    <TableColumn fx:id="colId" prefWidth="150" text="Complaint ID" />
                    <TableColumn fx:id="colCategory" prefWidth="250" text="Title" />
                    <TableColumn fx:id="colDescription" prefWidth="400" text="Description" />
                </columns>
            </TableView>
        </VBox>
    </center>
</BorderPane>