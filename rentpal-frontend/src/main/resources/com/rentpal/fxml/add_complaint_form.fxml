<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>
<?import javafx.geometry.Pos?>

<?import java.net.URL?>
<AnchorPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.rentpal.controllers.tenantdashboard.AddComplaintController"
            prefWidth="500" prefHeight="450"
            styleClass="dialog-pane">
    <stylesheets>
        <URL value="@/css/tenant_dialog.css" />
    </stylesheets>


    <VBox alignment="TOP_CENTER" spacing="20" AnchorPane.topAnchor="20" AnchorPane.leftAnchor="30"
          AnchorPane.rightAnchor="30" AnchorPane.bottomAnchor="20">

        <Label text="Add Complaint" styleClass="dialog-title"/>


        <GridPane hgap="10" vgap="15">
            <columnConstraints>
                <ColumnConstraints halignment="RIGHT" prefWidth="120"/>
                <ColumnConstraints halignment="LEFT" prefWidth="300"/>
            </columnConstraints>

            <!-- Owner Selection (visible for tenants) -->
            <Label fx:id="ownerSelectionLabel" text="Select Owner:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <ComboBox fx:id="ownerComboBox" promptText="Select owner"
                      GridPane.rowIndex="0" GridPane.columnIndex="1"/>

            <Label text="Category:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <ComboBox fx:id="categoryField" GridPane.rowIndex="1" GridPane.columnIndex="1"
                      promptText="Select category"/>

            <Label text="Description:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
            <TextArea fx:id="descriptionField" GridPane.rowIndex="2" GridPane.columnIndex="1"
                      prefRowCount="4" wrapText="true"/>

            <Label text="Priority:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
            <ComboBox fx:id="priorityField" GridPane.rowIndex="3" GridPane.columnIndex="1"
                      promptText="Select priority"/>

        </GridPane>

        <HBox spacing="15" alignment="CENTER">
            <Button text="Submit" fx:id="submitButton" onAction="#handleSubmit" styleClass="primary-btn"/>
            <Button text="Cancel" onAction="#handleCancel" styleClass="secondary-btn"/>
        </HBox>
    </VBox>
</AnchorPane>