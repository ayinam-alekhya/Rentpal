<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.rentpal.controllers.tenantdashboard.TenantPaymentsController"
      spacing="25" alignment="TOP_CENTER"
      styleClass="content-area">
    <padding>
        <Insets top="30" right="30" bottom="30" left="30"/>
    </padding>

    <Label text="My Payments" styleClass="page-title"/>

    <HBox spacing="20" alignment="CENTER_LEFT" styleClass="filter-bar">
        <TextField fx:id="searchField" promptText="Search by date or amount..." styleClass="search-field"/>
        <ComboBox fx:id="filterComboBox" promptText="Filter by status" prefWidth="150"/>
    </HBox>

    <TableView fx:id="paymentsTable" prefHeight="400" styleClass="modern-table">
        <columns>
            <TableColumn fx:id="dateColumn" text="Date" prefWidth="200"/>
            <TableColumn fx:id="amountColumn" text="Amount ($)" prefWidth="200"/>
            <TableColumn fx:id="statusColumn" text="Status" prefWidth="150"/>
            <TableColumn fx:id="methodColumn" text="Method" prefWidth="150"/>
        </columns>
    </TableView>
</VBox>