<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefWidth="980" prefHeight="700"
            xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.rentpal.controllers.ownerdashboard.OwnerComplaintsController"
            styleClass="content-inner">

    <top>
        <HBox spacing="15" styleClass="page-header">
            <Pane HBox.hgrow="ALWAYS">
                <children>
                    <Label alignment="CENTER" layoutX="441.0" layoutY="2.0"
                           styleClass="page-title"
                           text="Manage Tenant Complaints"/>
                </children>
            </Pane>
            <Button fx:id="refreshButton" text="↻ Refresh" onAction="#handleRefresh"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="15" styleClass="main-content">
            <TableView fx:id="complaintsTable" prefHeight="600" editable="true" styleClass="table-view">
                <columns>
                    <TableColumn fx:id="colId"          prefWidth="100" text="ID"/>
                    <TableColumn fx:id="colTenant"      prefWidth="160" text="Tenant"/>
                    <TableColumn fx:id="colTitle"       prefWidth="220" text="Title"/>
                    <TableColumn fx:id="colDescription" prefWidth="300" text="Description"/>
                    <TableColumn fx:id="colStatus"      prefWidth="160" text="Status"/>
                </columns>
            </TableView>
        </VBox>
    </center>
</BorderPane>
